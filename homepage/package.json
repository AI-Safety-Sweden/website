  },
  "devDependencies": {
    "elm": "^0.19.1-6",
    "elm-format": "^0.8.8",
    "elm-pages": "^3.5.0",
    "elm-review": "^2.13.5",
    "lamdera": "0.19.1-1.3.2",
    "vite": "^7.3.2"
  },
  "private": true
}
